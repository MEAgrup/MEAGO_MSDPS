# MSDPS environment — STAGING. Copy ke .env.local (atau isikan sebagai
# Vercel Preview env untuk branch `staging`) dan lengkapi key di bawah.
# Detail lengkap: docs/STAGING.md
#
# Project Supabase staging: "MSDPS Staging" (ref vgjzvdpxrdoefoncuazw)
# — DUPLIKAT dari production, JANGAN dipakai untuk data production asli.

# Public (safe for browser, RLS-bound):
NEXT_PUBLIC_SUPABASE_URL=https://vgjzvdpxrdoefoncuazw.supabase.co
# Ambil dari dashboard Supabase project "MSDPS Staging" -> Settings -> API -> anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER import into client bundles. Bypasses RLS (not triggers).
# Ambil dari dashboard Supabase project "MSDPS Staging" -> Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=
