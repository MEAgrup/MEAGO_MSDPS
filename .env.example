# MSDPS environment — copy to .env.local and fill in.
# Untuk nilai staging (bukan production), lihat .env.staging.example dan docs/STAGING.md.
# Public (safe for browser, RLS-bound):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER import into client bundles. Bypasses RLS (not triggers).
# Used only by trusted server jobs (LSR ingestion, scheduled snapshots if run
# outside pg_cron).
SUPABASE_SERVICE_ROLE_KEY=

# Bridge MSDPS→CDPS Fase 1 (migr. 0360, app/api/internal/bridge/deliver).
# Server-only, no NEXT_PUBLIC_ prefix. Different value per environment.
#
# OUTBOUND — sent to CDPS's POST /api/v1/internal/bridge/orders as
# `Authorization: Bearer`. Must match CDPS's own BRIDGE_INGEST_SECRET
# (AgencyAPP/apps/api). Unset ⇒ delivery job silently skips (logs, never
# throws) rather than burning retry attempts on a config problem.
CDPS_BRIDGE_INGEST_SECRET=
# INBOUND — gates who may trigger the delivery job tick itself. Vercel Cron
# injects `Authorization: Bearer <CRON_SECRET>` and cannot send a custom
# header, so it must be named exactly CRON_SECRET for Vercel to populate it.
# curl/GitHub Actions may instead send `x-bridge-deliver-secret` matching
# BRIDGE_DELIVER_SECRET. Set either (or both, same value) — both unset ⇒
# every tick request rejected (fail-closed).
CRON_SECRET=
BRIDGE_DELIVER_SECRET=
# Optional override of CDPS's base URL (default: the verified production
# https://agency-app-api.vercel.app — see lib/bridge/deliver.ts). Set this
# only when pointing the delivery job at a CDPS staging deployment.
CDPS_BRIDGE_BASE_URL=
